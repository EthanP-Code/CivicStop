# Copy to .env and fill in. Never commit real values.
DATABASE_URL=postgresql://civitstop:localdev@localhost:5432/civitstop
SPACES_BUCKET=civitstop-local
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
# At least 32 random bytes, base64. Generate: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOKEN_HASH_SECRET=
MAX_IMAGE_BYTES=5242880
# Worker only
GEMINI_API_KEY=
