DATABASE_URL=postgresql://stopshade:localdev@localhost:5432/stopshade
SPACES_BUCKET=stopshade
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY=replace-me
SPACES_SECRET_KEY=replace-me
TOKEN_HASH_SECRET=replace-with-at-least-32-random-bytes
MAX_IMAGE_BYTES=5242880

# Required only by the background worker. Never commit a real key.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=45
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
